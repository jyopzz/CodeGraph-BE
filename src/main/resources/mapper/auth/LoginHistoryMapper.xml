<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.CodeGraph.auth.mapper.LoginHistoryMapper">

    <resultMap
            id="LoginHistoryResultMap"
            type="com.CodeGraph.auth.model.LoginHistory">

        <id
                property="id"
                column="id"/>

        <result
                property="userId"
                column="user_id"/>

        <result
                property="email"
                column="email"/>

        <result
                property="ipAddress"
                column="ip_address"/>

        <result
                property="attemptedAt"
                column="attempted_at"/>

        <result
                property="successful"
                column="successful"/>

    </resultMap>

    <insert
            id="insert"
            parameterType="com.CodeGraph.auth.model.LoginHistory"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">

        INSERT INTO login_history (
        user_id,
        email,
        ip_address,
        attempted_at,
        successful
        )
        VALUES (
        #{userId},
        #{email},
        #{ipAddress},
        #{attemptedAt},
        #{successful}
        )

    </insert>

</mapper>