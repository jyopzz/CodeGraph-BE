<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.CodeGraph.auth.mapper.AuthSessionMapper">

    <!-- ========================================================= -->
    <!-- Result Map -->
    <!-- ========================================================= -->

    <resultMap
            id="AuthSessionResultMap"
            type="com.CodeGraph.auth.model.AuthSession">

        <id
                property="id"
                column="id"/>

        <result
                property="userId"
                column="user_id"/>

        <result
                property="sessionId"
                column="session_id"
                typeHandler="com.CodeGraph.common.mybatis.UUIDTypeHandler"/>

        <result
                property="accessTokenId"
                column="access_token_id"
                typeHandler="com.CodeGraph.common.mybatis.UUIDTypeHandler"/>

        <result
                property="createdAt"
                column="created_at"/>

        <result
                property="createdIp"
                column="created_ip"/>

        <result
                property="expiresAt"
                column="expires_at"/>

        <result
                property="revokedAt"
                column="revoked_at"/>

    </resultMap>


    <!-- ========================================================= -->
    <!-- Insert Session -->
    <!-- ========================================================= -->

    <insert
            id="insert"
            parameterType="com.CodeGraph.auth.model.AuthSession"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">

        INSERT INTO auth_sessions (
        user_id,
        session_id,
        access_token_id,
        created_at,
        created_ip,
        expires_at
        )
        VALUES (
        #{userId},
        #{sessionId,
          typeHandler=com.CodeGraph.common.mybatis.UUIDTypeHandler},
        #{accessTokenId,
          typeHandler=com.CodeGraph.common.mybatis.UUIDTypeHandler},
        #{createdAt},
        #{createdIp},
        #{expiresAt}
        )

    </insert>


    <!-- ========================================================= -->
    <!-- Find Session -->
    <!-- ========================================================= -->

    <select
            id="findBySessionId"
            resultMap="AuthSessionResultMap">

        SELECT
        id,
        user_id,
        session_id,
        access_token_id,
        created_at,
        created_ip,
        expires_at,
        revoked_at
        FROM auth_sessions
        WHERE session_id =
        #{sessionId,
          typeHandler=com.CodeGraph.common.mybatis.UUIDTypeHandler}
        LIMIT 1

    </select>


    <!-- ========================================================= -->
    <!-- Update Access Token ID -->
    <!-- ========================================================= -->

    <update id="updateAccessTokenId">

        UPDATE auth_sessions
        SET access_token_id =
        #{accessTokenId,
          typeHandler=com.CodeGraph.common.mybatis.UUIDTypeHandler}
        WHERE session_id =
        #{sessionId,
          typeHandler=com.CodeGraph.common.mybatis.UUIDTypeHandler}
        AND revoked_at IS NULL

    </update>


    <!-- ========================================================= -->
    <!-- Revoke Session -->
    <!-- ========================================================= -->

    <update id="revoke">

        UPDATE auth_sessions
        SET revoked_at = CURRENT_TIMESTAMP
        WHERE session_id =
        #{sessionId,
          typeHandler=com.CodeGraph.common.mybatis.UUIDTypeHandler}
        AND revoked_at IS NULL

    </update>


    <!-- ========================================================= -->
    <!-- Revoke All User Sessions -->
    <!-- ========================================================= -->

    <update id="revokeAllByUserId">

        UPDATE auth_sessions
        SET revoked_at = CURRENT_TIMESTAMP
        WHERE user_id = #{userId}
        AND revoked_at IS NULL

    </update>

</mapper>